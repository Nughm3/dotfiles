type            = process
command         = /usr/bin/syncthing serve --no-browser --no-restart --logflags=19 --home=$HOME/.config/syncthing  --logfile=$HOME/.local/share/dinit/syncthing.log
working-dir     = $HOME/.config/syncthing
term-signal     = TERM
load-options    = export-passwd-vars
log-type        = none
smooth-recovery = false
restart         = false
stop-timeout    = 20.000
